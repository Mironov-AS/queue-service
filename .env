# Server
PORT=3000
CORS_ORIGIN=*
JWT_SECRET=

# AWS S3 (для хранения рекламных файлов)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Для MinIO или других S3-совместимых сервисов (необязательно)
# AWS_ENDPOINT_URL=http://localhost:9000
# AWS_S3_FORCE_PATH_STYLE=true
