PORT=3001
# Allowed CORS origin. Use specific domain in production, e.g. https://myqueue.example.com
CORS_ORIGIN=*
# Generate with: node -e "require('crypto').randomBytes(48).toString('hex')"
JWT_SECRET=change_me_before_deploying
# Must match auth-service JWT_ACCESS_SECRET for client portal token verification
JWT_ACCESS_SECRET=change_me_must_match_auth_service
